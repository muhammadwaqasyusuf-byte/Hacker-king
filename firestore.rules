rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLicense(data) {
      return data.license_key is string &&
             data.license_key.size() > 0 &&
             data.license_key.size() <= 64 &&
             data.full_name is string &&
             data.full_name.size() > 0 &&
             data.full_name.size() <= 128 &&
             data.status in ['pending', 'approved', 'blocked'];
    }

    function isValidSignal(data) {
      return data.id is string &&
             data.id.size() > 0 &&
             data.id.size() <= 64 &&
             data.pair is string &&
             data.pair.size() > 0 &&
             data.pair.size() <= 32 &&
             data.direction in ['BUY', 'SELL'] &&
             data.entry is string &&
             data.entry.size() > 0;
    }

    // App config document (admin settings, URLs, master key)
    match /config/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Licenses collection
    match /licenses/{licenseId} {
      allow get, list: if true;
      allow create: if isValidId(licenseId) && isValidLicense(incoming());
      allow update: if isValidId(licenseId) && isValidLicense(incoming());
      allow delete: if isValidId(licenseId);
    }

    // Signals collection
    match /signals/{signalId} {
      allow get, list: if true;
      allow create: if isValidId(signalId) && isValidSignal(incoming());
      allow update: if false;
      allow delete: if isValidId(signalId);
    }
  }
}
